<article class="hero-slide">

  {% if content.field_image %}
    <div class="hero-slide__image">
      {{ content.field_image }}
    </div>
  {% endif %}

  <div class="hero-slide__content">

    {% if content.field_title %}
      <h1 class="hero-slide__title">
        {{ content.field_title }}
      </h1>
    {% endif %}

    {% if content.field_text %}
      <div class="hero-slide__text">
        {{ content.field_text }}
      </div>
    {% endif %}

    {% if content.field_button %}
      <div class="hero-slide__button">
        {{ content.field_button }}
      </div>
    {% endif %}

  </div>

</article>