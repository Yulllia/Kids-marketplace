<article class="product-card">

	<a href="{{ url }}" class="product-card__link">
		<div class="product-card__image">
			{{ product_first_image }}
		</div>

		<div class="product-card__info">
			<h2 class="product-card__title">
				{{ label }}
			</h2>

			<div class="product-card__price">
				{{ content.field_price }}
			</div>
		</div>
	</a>

</article>
